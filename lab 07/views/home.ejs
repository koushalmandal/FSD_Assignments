<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Library | Home</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="hero">
            <div>
                <p class="eyebrow">YOUR NEXT ADVENTURE STARTS HERE</p>
                <h1>Welcome to <span>Game Library</span></h1>
                <p class="hero-text">Discover exciting worlds, keep track of your favourite games, and build a library that is uniquely yours.</p>
                <a class="button primary-button" href="/games">Explore All Games</a>
            </div>
            <div class="hero-icon" aria-hidden="true">🎮</div>
        </section>

        <section class="section-heading">
            <div>
                <p class="eyebrow">HAND-PICKED FOR YOU</p>
                <h2>Featured Games</h2>
            </div>
            <a class="text-link" href="/games">View collection →</a>
        </section>

        <section class="game-grid">
            <% games.forEach(game => { %>
                <article class="game-card">
                    <img src="<%= game.image %>" alt="Cover placeholder for <%= game.title %>">
                    <div class="game-card-content">
                        <div class="game-card-topline">
                            <span class="genre"><%= game.genre %></span>
                            <span class="rating">★ <%= game.rating %></span>
                        </div>
                        <h3><%= game.title %></h3>
                        <% if (game.rating >= 4.5) { %>
                            <p class="highly-rated">Highly Rated</p>
                        <% } %>
                        <a class="button secondary-button" href="/game/<%= game.id %>">View Details</a>
                    </div>
                </article>
            <% }); %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
