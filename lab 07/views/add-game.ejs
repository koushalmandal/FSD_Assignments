<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Library | Add Game</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main class="page-content narrow-content">
        <section class="page-heading">
            <p class="eyebrow">GROW YOUR COLLECTION</p>
            <h1>Add a New Game</h1>
            <p>Enter the details below to add a game to the in-memory library.</p>
        </section>

        <form class="game-form" action="/add-game" method="POST">
            <label for="title">Game Title</label>
            <input id="title" name="title" type="text" placeholder="e.g. Hollow Knight" required>

            <label for="genre">Genre</label>
            <input id="genre" name="genre" type="text" placeholder="e.g. Adventure" required>

            <label for="platform">Platform</label>
            <input id="platform" name="platform" type="text" placeholder="e.g. PC, Switch" required>

            <label for="rating">Rating</label>
            <input id="rating" name="rating" type="number" min="0" max="5" step="0.1" placeholder="e.g. 4.5" required>

            <label for="image">Image URL</label>
            <input id="image" name="image" type="url" placeholder="https://placehold.co/600x800?text=New+Game">

            <label for="description">Description</label>
            <textarea id="description" name="description" rows="5" placeholder="Tell players what makes this game special." required></textarea>

            <button class="button primary-button" type="submit">Add Game</button>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
