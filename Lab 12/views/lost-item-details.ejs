<%- include('partials/header', { title: item.itemName }) %>
<div class="breadcrumbs"><a href="/lost-items">Lost items</a><span>/</span><span><%= item.itemName %></span></div>
<section class="detail-layout"><div class="detail-main"><div class="eyebrow"><span class="status-pulse pulse-orange"></span> LOST ITEM <span class="dot">·</span> <%= item.category %></div><h1><%= item.itemName %><span class="title-period">.</span></h1><p class="detail-description"><%= item.description %></p><div class="detail-facts"><div><span class="fact-icon">⌖</span><span><small>LAST SEEN</small><strong><%= item.lastSeenLocation %></strong></span></div><div><span class="fact-icon">▦</span><span><small>DATE LOST</small><strong><%= new Date(item.dateLost).toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' }) %></strong></span></div><div><span class="fact-icon">◉</span><span><small>STATUS</small><strong><%= item.status %></strong></span></div></div></div>
<aside class="reporter-card"><div class="eyebrow">THE PERSON LOOKING</div><div class="reporter-avatar"><%= item.reportedBy.fullName.split(' ').map(part => part[0]).slice(0,2).join('').toUpperCase() %></div><h2><%= item.reportedBy.fullName %></h2><p><%= item.reportedBy.department %></p><a class="contact-link" href="mailto:<%= item.reportedBy.email %>">Get in touch <span>↗</span></a><a class="profile-link" href="/students/<%= item.reportedBy._id %>">View student profile →</a></aside></section>
<%- include('partials/footer') %>
