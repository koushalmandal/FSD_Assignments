<%- include('partials/header', { title: 'Lost items' }) %>
<section class="page-intro"><div><div class="eyebrow">THE COMMUNITY BOARD</div><h1>Lost items<span class="title-period">.</span></h1><p>Help a neighbor find what’s missing. Every detail might be the clue they need.</p></div><a class="button button-dark" href="/lost-items/new">Report a lost item <span>↗</span></a></section>
<form class="search-bar" action="/lost-items" method="get"><span class="search-icon">⌕</span><input type="search" name="q" value="<%= query %>" placeholder="Search name, category, or location"><button class="button button-small button-dark" type="submit">Search <span>→</span></button></form>
<div class="list-context"><span><strong><%= items.length %></strong> <%= items.length === 1 ? 'report' : 'reports' %><%= query ? ` matching “${query}”` : ' on the board' %></span><a href="/found-items">Looking for found items? <span>→</span></a></div>
<% if (items.length) { %><div class="card-grid"><% items.forEach(item => { %><%- include('partials/item-card', { item, kind: 'LOST' }) %><% }) %></div><% } else { %><div class="empty-state"><div class="empty-icon">⌕</div><h3><%= query ? 'No reports match that search.' : 'No lost items reported yet.' %></h3><p><%= query ? 'Try another name, category, or location.' : 'Be the first to put a lost item on the board.' %></p><a class="button button-lime" href="/lost-items/new">Report a lost item <span>↗</span></a></div><% } %>
<%- include('partials/footer') %>
