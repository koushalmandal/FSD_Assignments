<%- include('partials/header', { title: 'Report a lost item' }) %>
<section class="form-layout"><div class="form-aside"><div class="eyebrow">LET’S GET IT BACK</div><h1>Every clue <span>counts.</span></h1><p>Share the details you remember. A location, a date, even a small detail can make all the difference.</p><div class="aside-note"><span>⌖</span><div><strong>Be as specific as you can.</strong><br>It helps someone spot the right item and get it back to you.</div></div></div>
<form class="form-panel" method="post" action="/lost-items"><div class="form-panel-heading"><div class="eyebrow">LOST ITEM REPORT</div><span class="step-mark">01 <i>/</i> 01</span></div><h2>What went missing?</h2><p class="form-subtitle">All fields are required.</p>
<% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %>
<div class="form-row"><label>Item name<input name="itemName" required maxlength="100" placeholder="e.g. Blue water bottle" value="<%= values.itemName || '' %>"></label><label>Category<input name="category" required maxlength="60" placeholder="e.g. Drinkware" value="<%= values.category || '' %>"></label></div>
<label>Description<textarea name="description" required maxlength="1000" rows="3" placeholder="Color, brand, or any details that might help"><%= values.description || '' %></textarea></label>
<div class="form-row"><label>Last seen location<input name="lastSeenLocation" required maxlength="150" placeholder="e.g. Library, second floor" value="<%= values.lastSeenLocation || '' %>"></label><label>Date lost<input name="dateLost" type="date" required max="<%= new Date().toISOString().slice(0,10) %>" value="<%= values.dateLost || '' %>"></label></div>
<p class="inline-hint">Report submitted as your selected student profile. <a href="/students/new">Switch profile</a></p><button class="button button-dark button-wide" type="submit" >Post lost item <span>↗</span></button><p class="form-footnote"><a href="/lost-items">← Back to lost items</a></p></form></section>
<%- include('partials/footer') %>
