<%- include('partials/header', { title: item.itemName }) %>
<div class="breadcrumbs"><a href="/found-items">Found items</a><span>/</span><span><%= item.itemName %></span></div>
<section class="detail-layout"><div class="detail-main"><div class="eyebrow"><span class="status-pulse"></span> FOUND ITEM <span class="dot">·</span> <%= item.category %></div><h1><%= item.itemName %><span class="title-period">.</span></h1><p class="detail-description"><%= item.description %></p><div class="detail-facts"><div><span class="fact-icon">⌖</span><span><small>FOUND AT</small><strong><%= item.foundLocation %></strong></span></div><div><span class="fact-icon">▦</span><span><small>DATE FOUND</small><strong><%= new Date(item.dateFound).toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' }) %></strong></span></div><div><span class="fact-icon">◉</span><span><small>STATUS</small><strong><%= item.status %></strong></span></div></div></div>
<aside class="reporter-card"><div class="eyebrow">THE HELPFUL HUMAN</div><div class="reporter-avatar avatar-lime"><%= item.reportedBy.fullName.split(' ').map(part => part[0]).slice(0,2).join('').toUpperCase() %></div><h2><%= item.reportedBy.fullName %></h2><p><%= item.reportedBy.department %></p><a class="contact-link" href="mailto:<%= item.reportedBy.email %>">Get in touch <span>↗</span></a><a class="profile-link" href="/students/<%= item.reportedBy._id %>">View student profile →</a></aside></section>

<section class="phase-two-panel"><div class="eyebrow">CLAIM &amp; RETURN</div><h2>Claims for this item <span class="claim-count"><%= claims.length %></span></h2>
<% if (item.status === 'Returned') { %><p class="notice success">This item has been returned. New claims are closed.</p><% } %>
<% if (isOwner) { %><p class="inline-hint">You reported this item. Review claims below; only your profile can approve or reject them.</p><% } else if (!currentStudentId) { %><p class="inline-hint"><a href="/students/new">Choose a student profile</a> to submit a claim.</p><% } else if (ownClaim) { %><p class="inline-hint">Your claim status: <strong><%= ownClaim.status %></strong>.</p><% } else if (item.status === 'Available') { %>
<form class="claim-form" method="post" action="/found-items/<%= item._id %>/claims"><label>Why does this item belong to you?<textarea name="reason" required minlength="10" maxlength="1000" rows="4" placeholder="Describe a detail that helps identify it as yours."></textarea></label><button class="button button-dark" type="submit">Submit claim</button></form>
<% } %>
<div class="claim-list"><% if (!claims.length) { %><p class="inline-hint">No claims have been submitted yet.</p><% } %><% claims.forEach(claim => { %><article class="claim-row"><div class="claim-heading"><strong><%= claim.claimedBy.fullName %></strong><span class="claim-status status-<%= claim.status.toLowerCase() %>"><%= claim.status %></span></div><p><%= claim.reason %></p><small>Submitted <%= claim.createdAt.toLocaleString() %></small>
<% if (isOwner && item.status === 'Available' && claim.status === 'Pending') { %><div class="claim-actions"><form method="post" action="/claims/<%= claim._id %>/status?_method=PATCH"><input type="hidden" name="status" value="Rejected"><button class="button button-light" type="submit">Reject</button></form><form method="post" action="/claims/<%= claim._id %>/status?_method=PATCH"><input type="hidden" name="status" value="Approved"><button class="button button-dark" type="submit">Approve &amp; return item</button></form></div><% } %></article><% }) %></div></section>
<%- include('partials/footer') %>
