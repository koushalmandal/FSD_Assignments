<article class="item-card">
  <div class="card-topline"><span class="eyebrow"><%= kind %> <span class="dot">·</span> <%= item.category %></span><span class="card-arrow">↗</span></div>
  <h3><a href="/<%= kind === 'LOST' ? 'lost-items' : 'found-items' %>/<%= item._id %>"><%= item.itemName %></a></h3>
  <p class="card-description"><%= item.description %></p>
  <div class="card-meta"><span><span class="meta-icon">⌖</span><%= kind === 'LOST' ? item.lastSeenLocation : item.foundLocation %></span><span><%= new Date(kind === 'LOST' ? item.dateLost : item.dateFound).toLocaleDateString('en', { month: 'short', day: 'numeric' }) %></span></div>
  <div class="card-owner">Reported by <strong><%= item.reportedBy ? item.reportedBy.fullName : 'Student' %></strong></div>
</article>
