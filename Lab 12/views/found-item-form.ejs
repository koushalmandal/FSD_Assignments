<%- include('partials/header', { title: 'Report a found item' }) %>
<section class="form-layout"><div class="form-aside"><div class="eyebrow">A KIND THING TO DO</div><h1>Found it? <span>Share it.</span></h1><p>Your report might be exactly what someone needs to see today. Add a few details and we’ll put it on the board.</p><div class="aside-note"><span>✳</span><div><strong>Thank you for looking out.</strong><br>A little care can turn a stressful day around.</div></div></div>
<form class="form-panel" method="post" action="/found-items"><div class="form-panel-heading"><div class="eyebrow">FOUND ITEM REPORT</div><span class="step-mark">01 <i>/</i> 01</span></div><h2>What did you find?</h2><p class="form-subtitle">All fields are required.</p>
<% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %>
<div class="form-row"><label>Item name<input name="itemName" required maxlength="100" placeholder="e.g. Blue water bottle" value="<%= values.itemName || '' %>"></label><label>Category<input name="category" required maxlength="60" placeholder="e.g. Drinkware" value="<%= values.category || '' %>"></label></div>
<label>Description<textarea name="description" required maxlength="1000" rows="3" placeholder="Color, brand, or any details that might help"><%= values.description || '' %></textarea></label>
<div class="form-row"><label>Found location<input name="foundLocation" required maxlength="150" placeholder="e.g. Library, second floor" value="<%= values.foundLocation || '' %>"></label><label>Date found<input name="dateFound" type="date" required max="<%= new Date().toISOString().slice(0,10) %>" value="<%= values.dateFound || '' %>"></label></div>
<p class="inline-hint">Report submitted as your selected student profile. <a href="/students/new">Switch profile</a></p><button class="button button-dark button-wide" type="submit" >Post found item <span>↗</span></button><p class="form-footnote"><a href="/found-items">← Back to found items</a></p></form></section>
<%- include('partials/footer') %>
