<%- include('partials/header', { title: 'Create student profile' }) %>
<section class="form-layout"><div class="form-aside"><div class="eyebrow">FIRST, A LITTLE INTRO</div><h1>Good things start with <span>a name.</span></h1><p>Create your student profile so reports can be connected to the person who shared them.</p><div class="aside-note"><span>✳</span><div><strong>Your details stay useful.</strong><br>Names and contact information help the campus community make a return.</div></div></div>
<form class="form-panel" method="post" action="/students"><div class="form-panel-heading"><div class="eyebrow">STUDENT PROFILE</div><span class="step-mark">01 <i>/</i> 01</span></div><h2>Tell us about you</h2><p class="form-subtitle">All fields are required.</p>
<% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %>
<label>Full name<input name="fullName" required maxlength="100" autocomplete="name" placeholder="e.g. Alex Morgan" value="<%= values.fullName || '' %>"></label>
<label>College email<input name="email" type="email" required autocomplete="email" placeholder="you@college.edu" value="<%= values.email || '' %>"></label>
<div class="form-row"><label>Department<input name="department" required maxlength="100" placeholder="e.g. Design" value="<%= values.department || '' %>"></label><label>Contact number<input name="contactNumber" type="tel" required maxlength="20" autocomplete="tel" placeholder="+91 98765 43210" value="<%= values.contactNumber || '' %>"></label></div>
<button class="button button-dark button-wide" type="submit">Create my profile <span>↗</span></button><p class="form-footnote">Already here? <a href="/">Back to the community board</a></p></form><% if (profiles.length) { %><form class="form-panel profile-picker" method="post" action="/session"><div class="eyebrow">ALREADY HAVE A PROFILE?</div><label>Choose your student profile<select name="studentId" required><option value="">Select a profile</option><% profiles.forEach(profile => { %><option value="<%= profile._id %>"><%= profile.fullName %> - <%= profile.email %></option><% }) %></select></label><button class="button button-light button-wide" type="submit">Continue as this student</button></form><% } %></section>
<%- include('partials/footer') %>
